<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the stored sign-in token on this phone only (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="capflix.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="capflix.xml" />
    </device-transfer>
</data-extraction-rules>
